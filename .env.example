# ---------- Core ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 32+ random chars: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
# Comma separated emails that become admins on login
ADMIN_EMAILS=you@example.com

# ---------- MongoDB Atlas (free M0) ----------
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=skilion

# ---------- Google OAuth ----------
# Console: APIs & Services > Credentials > OAuth client (Web).
# Redirect URI: {SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- GitHub OAuth ----------
# Settings > Developer settings > OAuth Apps.
# Callback URL: {SITE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Resend (OTP + notification emails) ----------
RESEND_API_KEY=
# Use a verified domain sender in production, e.g. Skilion <no-reply@skilion.vigotech.in>
RESEND_FROM=Skilion <onboarding@resend.dev>

# ---------- Gemini (free API key from aistudio.google.com) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# GST added on top of plan prices (percent). Confirm with your accountant.
GST_PERCENT=18

# ---------- Misc ----------
CONTACT_EMAIL=contact@vigotech.in
# Set to 1 to print AI illustration prompts inside placeholders (always on in dev)
NEXT_PUBLIC_SHOW_PROMPTS=0
